{{- /*
###########################################################################
# Configuration Overview
###########################################################################
This is the main configuration file for chezmoi.
Variables rendered into the [data] namespace are accessible in chezmoi
scripts and templates directly.  For example:
    {{ if .devLight }}
    Foo
    {{ end }}

Here are the properties "exported" by this configuration.

###########################################################################
# Exported properties
###########################################################################
upgrade_software            whether managed software should be upgraded to latest version.
                            This is a special property in that it is intended to be overridden at
                            the runtime invocation of chezmoi apply when appropriate.
baseSourceDir               the directory from which chezmoi pulls source files when applying
devFull                     whether to install full development tooling
devLight                    whether to install minimal development tooling
gitSigningKey               the git signing key
installPlex                 whether to install plex (windows only)
minimalWingetInstalls       whether to install minimal managed software (windows only)
scruthBackupStartBoundary   scruth-backup utilitiy start time (windows only)
*/ -}}

{{- /* Environment */ -}}
{{- $isMac := eq .chezmoi.os "darwin" -}}
{{- $isWin := eq .chezmoi.os "windows" -}}
{{- if not (or $isMac $isWin) -}}
    {{- warnf "Aborting. Unsupported OS: '%s'" .chezmoi.os -}}
    {{- exit 1 -}}
{{- end -}}
{{- $host := .chezmoi.hostname -}}

{{- $devFullHosts  := list "sfeinstein-studio-m4" "FAMILYFUN" -}}
{{- $devFull := has $host $devFullHosts -}}
{{- $devLightHosts := list "Scott's MacBook Pro" "RARSTEENS" -}}
{{- $devLight := or $devFull (has $host $devLightHosts) -}}

{{- /* Flag defaults */ -}}
{{- $baseSourceDir := (joinPath .chezmoi.sourceDir | quote) -}}
{{- $gitSigningKey := "" -}}
{{- $installPlex := false -}}
{{- $minimalWingetInstalls := true -}}
{{- $scruthBackupStartBoundary := "" -}}
{{- $sourceDir := .chezmoi.sourceDir -}}

{{- /* Flag overrides by OS */ -}}
{{- if $isMac -}}
    {{- $gitSigningKey = "id_github" -}}
    {{- $sourceDir = (joinPath .chezmoi.sourceDir "/src/macos" | quote) -}}
{{- else if $isWin -}}
    {{- $gitSigningKey = "id_ed25519_github_windows" -}}
    {{- $sourceDir = (joinPath .chezmoi.sourceDir "/src/windows" | quote) -}}
{{- end -}}

{{- /* Flag overrides by machine type */ -}}
{{- if $devFull -}}
    {{- $minimalWingetInstalls = false -}}
{{- end -}}

{{- /* Flag overrides by specific host */ -}}
{{- if eq "FAMILYFUN" $host -}}
{{-   $scruthBackupStartBoundary = "2026-03-28T12:00:00" -}}
{{- else if eq "RARSTEENS" $host -}}
{{-   $installPlex = true -}}
{{-   $scruthBackupStartBoundary = "2026-03-28T09:30:00" -}}
{{- else if eq "CraftingIsSexy" $host -}}
{{-   $scruthBackupStartBoundary = "2026-03-28T06:00:00" -}}
{{- end -}}

sourceDir = {{ $sourceDir }}
[data]
    upgrade_software = "false"
    baseSourceDir = {{ $baseSourceDir }}
    devFull = {{ $devFull }}
    devLight = {{ $devLight }}
    gitSigningKey = "{{ $gitSigningKey }}"
{{ if $isWin }}
    installPlex = {{ $installPlex }}
    minimalWingetInstalls = {{ $minimalWingetInstalls }}
    scruthBackupStartBoundary = "{{ $scruthBackupStartBoundary }}"
{{- end -}}
